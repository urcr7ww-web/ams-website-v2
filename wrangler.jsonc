{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ams-website-v2",
  "main": "src/index.js",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mobile-service-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  }
}
